{
  "name": "@portfolio/backend",
  "version": "2.0.0",
  "private": true,
  "description": "API for the Inam Sheraz portfolio. Holds every third-party credential so the browser never has to.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "node --watch-path=./src --watch-path=./scripts --env-file=.env src/server.js",
    "start": "node src/server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^9.0.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
