# =============================================================================
# BACKEND ENVIRONMENT
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every value here is read once, at boot, through src/config/env.js — which
# validates the whole file with zod and refuses to start if anything required
# is missing or malformed. A misconfigured server never boots half-working.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list. Requests from any other Origin are rejected by CORS.
# The voice endpoint additionally enforces this list itself — see ADR 0002.
CORS_ORIGINS=http://localhost:3000

# --- Database ----------------------------------------------------------------
# MongoDB stores contact messages, voice-session audit rows and audit logs.
# It does NOT store site content — that lives in the frontend as typed modules
# so the work renders even when the database is unreachable. See ADR 0003.
MONGODB_URI=mongodb://127.0.0.1:27017/inam-portfolio
MONGODB_MAX_POOL_SIZE=10

# --- Logging -----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Voice agent (ElevenLabs) ------------------------------------------------
# THE WHOLE POINT OF THIS SERVICE.
#
# The browser never sees this key. It calls POST /api/v1/voice/session, this
# server calls ElevenLabs with the key, and hands back only a signed WebSocket
# URL that expires in about a minute. See ADR 0002 and docs/05-security.md.
#
# VOICE_PROVIDER: elevenlabs | mock
#   mock  — no credentials needed, returns a fake session so the whole UI can
#           be developed and tested end to end. Never set this in production.
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_BASE=https://api.elevenlabs.io

# How many voice sessions one IP may start. The agent costs money per minute,
# so this is a cost control as much as an abuse control.
VOICE_RATE_LIMIT_WINDOW_MS=900000
VOICE_RATE_LIMIT_MAX=10
# Hard ceiling across all callers in the same window. Protects the bill if a
# single IP limit is bypassed by a distributed client.
VOICE_GLOBAL_LIMIT_MAX=120

# --- Contact form ------------------------------------------------------------
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# --- CAT gate ----------------------------------------------------------------
# The Children's Apperception Test set is password-gated at the researcher's
# request. Moving the check here keeps the password out of the JavaScript
# bundle. It is still a deterrent, not security — the images sit at guessable
# URLs and the UI says so plainly. See ADR 0004.
CAT_GATE_PASSWORD=apperception
GATE_RATE_LIMIT_WINDOW_MS=900000
GATE_RATE_LIMIT_MAX=20
