# =============================================================================
# FRONTEND ENVIRONMENT
#
# EVERY VARIABLE HERE IS PUBLIC.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle at build
# time and shipped to every visitor's browser. Treat this file as a file that
# gets published, because effectively it is.
#
# There is no ElevenLabs key here, and there must never be one. That is the
# entire architecture: the key lives in backend/.env, the browser asks the
# backend for a short-lived signed URL, and the credential never crosses the
# network to a client. See docs/adr/0002-voice-proxy.md.
# =============================================================================

# Where the browser sends /api/v1/* requests.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical site origin. Used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
